[submodule "submodules/three.js"]
	path = submodules/three.js
	url = https://github.com/bhouston/three.js.git
	branch = ssgi-traa-redesign
	ignore = dirty
[submodule "submodules/three-gpu-pathtracer"]
	path = submodules/three-gpu-pathtracer
	url = https://github.com/bhouston/three-gpu-pathtracer.git
	branch = ss-fidelity
	ignore = dirty
	shallow = true
[submodule "submodules/glTF-Sample-Assets"]
	path = submodules/glTF-Sample-Assets
	url = https://github.com/KhronosGroup/glTF-Sample-Assets.git
	ignore = dirty
[submodule "submodules/3d-demo-data"]
	path = submodules/3d-demo-data
	url = https://github.com/gkjohnson/3d-demo-data.git
	ignore = dirty
[submodule "submodules/ldraw-parts-library"]
	path = submodules/ldraw-parts-library
	url = https://github.com/gkjohnson/ldraw-parts-library.git
	ignore = dirty
